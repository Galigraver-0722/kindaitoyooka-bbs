{
  "name": "kindaitoyooka-bbs",
  "version": "0.1.0",
  "private": true,
  "description": "A school-run bulletin board for Kindai University Toyooka Junior & Senior High School.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "db:studio": "prisma studio",
    "archive-boards": "tsx scripts/archive-boards.ts",
    "backup": "tsx scripts/backup.ts",
    "verify-backup": "tsx scripts/verify-backup.ts",
    "restore": "tsx scripts/restore.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "naughty-words": "^1.2.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.5.1"
}
