# Copy to /srv/bbs/app/.env and edit before the first start.
DATABASE_URL="file:./prod.db"
NODE_ENV=production
COOKIE_SECURE=true

# Caddy sets X-Forwarded-For and overwrites anything the client sent, so the
# limiter can trust it here. Do not enable this on a directly exposed app.
TRUST_PROXY=1

# Student boards with no activity for this many days are archived by
# `pnpm archive-boards` (see the cron entry in docs/07-operations.md).
BOARD_ARCHIVE_DAYS=90

# Tighten individual limits only if the beta shows a need. Defaults are in
# src/lib/rate-limit.ts and documented in docs/07-operations.md.
# RATE_LIMIT_LOGIN_LIMIT=10
# RATE_LIMIT_LOGIN_WINDOW_MIN=10
