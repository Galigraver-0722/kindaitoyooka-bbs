[Unit]
Description=Toyooka BBS
After=network.target

[Service]
Type=simple
User=bbs
Group=bbs
WorkingDirectory=/srv/bbs/app
EnvironmentFile=/srv/bbs/app/.env
Environment=NODE_ENV=production
# Replace with the output of `command -v pnpm` on the server.
ExecStart=/usr/local/bin/pnpm start -p 3000
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
# A 1 GB box must not be pushed into the kernel OOM killer by one request.
MemoryMax=900M

[Install]
WantedBy=multi-user.target
