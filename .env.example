# Copy this file to `.env` before running the app.

# SQLite database file. The path is resolved relative to the `prisma/` directory,
# so this value creates `prisma/dev.db`.
DATABASE_URL="file:./dev.db"

# Cookies are marked Secure in production. Set this to "false" only if you must
# serve the app over plain HTTP (for example on a school LAN), never in public.
# COOKIE_SECURE=false
