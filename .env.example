# Copy this file to `.env` before running the app.

# SQLite database file. The path is resolved relative to the `prisma/` directory,
# so this value creates `prisma/dev.db`.
DATABASE_URL="file:./dev.db"

# Cookies are marked Secure in production. Set this to "false" only if you must
# serve the app over plain HTTP (for example on a school LAN), never in public.
# COOKIE_SECURE=false

# Rate limits are fixed windows stored in SQLite, so they survive a restart.
# The defaults are tuned for a class sharing one school IP; each limit can be
# overridden independently. Counters are keyed by the address in
# X-Forwarded-For, which is only trusted when TRUST_PROXY is on — set it behind
# Caddy or another proxy that overwrites the header.
# TRUST_PROXY=1
# RATE_LIMIT_LOGIN_LIMIT=10
# RATE_LIMIT_LOGIN_WINDOW_MIN=10
# RATE_LIMIT_THREAD_LIMIT=10
# RATE_LIMIT_REPLY_LIMIT=60
# RATE_LIMIT_REPORT_LIMIT=30
# RATE_LIMIT_LIKE_LIMIT=300

# A student board with no thread activity for this many days is archived by the
# daily `pnpm archive-boards` run. Defaults to 90.
# BOARD_ARCHIVE_DAYS=90
