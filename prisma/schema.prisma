// Data model for the Toyooka BBS.
//
// Conventions:
// - `cuid()` ids keep URLs opaque and sortable enough for a small community.
// - Content is soft-deleted (`isDeleted`) so moderation stays auditable.
// - Every account is local to this app; no external identity provider yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum BoardKind {
  OFFICIAL
  COMMUNITY
}

enum Role {
  STUDENT
  MODERATOR
  ADMIN
}

enum ReportSource {
  USER
  AUTO
}

model User {
  id              String           @id @default(cuid())
  username        String           @unique
  email           String?          @unique
  passwordHash    String
  role            Role             @default(STUDENT)
  avatarColor     String?
  avatarRing      String?
  bio             String?
  // Suspension is reversible and keeps every row: a suspended account cannot
  // sign in and every session is deleted, but its posts stay for the record.
  isSuspended     Boolean          @default(false)
  suspendedAt     DateTime?
  suspendedReason String?
  // Last time the reader opened the notification inbox. Anything newer is
  // counted as unseen; the events themselves are derived from existing rows.
  notificationsSeenAt DateTime?
  // Versions of the four documents accepted at registration, e.g.
  // "terms:2026-10-27;rules:2026-10-27;privacy:2026-10-27;moderation:2026-10-27".
  acceptedPolicies String?
  // Last time the reader opened the announcements panel. The entries live in
  // their own table, so only the moment is stored on the reader.
  announcementsSeenAt DateTime?
  // Registration requires accepting the terms. The timestamp and the version
  // accepted are the evidence; accounts created before the requirement existed
  // carry null and are not re-prompted.
  termsAcceptedAt DateTime?
  termsVersion    String?
  createdAt       DateTime         @default(now())
  sessions        Session[]
  threads         Thread[]
  posts           Post[]
  reports         Report[]         @relation("ReportAuthor")
  resolvedReports Report[]         @relation("ReportResolver")
  postLikes       PostLike[]
  threadBookmarks ThreadBookmark[]
  threadReads     ThreadRead[]
  threadLikes     ThreadLike[]
  ownedBoards     Board[]       @relation("BoardOwner")
  auditLogs       AuditLog[]       @relation("AuditActor")
  blockedAttempts BlockedAttempt[]
  announcements   Announcement[]   @relation("AnnouncementAuthor")
}

model Session {
  // SHA-256 of the cookie token, never the token itself.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Board {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  kind        BoardKind @default(OFFICIAL)
  ownerId     String?
  owner       User?     @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  sortOrder     Int      @default(0)
  isArchived    Boolean  @default(false)
  // Comma-separated tag hints for the compose form, e.g. "質問,試験,宿題".
  suggestedTags String   @default("")
  createdAt     DateTime @default(now())
  threads       Thread[]
}

model Thread {
  id            String           @id @default(cuid())
  boardId       String
  board         Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  authorId      String
  author        User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title         String
  isPinned      Boolean          @default(false)
  isLocked      Boolean          @default(false)
  isDeleted     Boolean          @default(false)
  likeCount     Int              @default(0)
  bookmarkCount Int              @default(0)
  createdAt     DateTime         @default(now())
  lastPostAt    DateTime         @default(now())
  editedAt      DateTime?
  updatedAt     DateTime         @updatedAt
  posts         Post[]
  tags          Tag[]
  bookmarks     ThreadBookmark[]
  reads         ThreadRead[]
  likes         ThreadLike[]

  @@index([boardId, lastPostAt])
  @@index([likeCount])
}

model Post {
  id        String     @id @default(cuid())
  threadId  String
  thread    Thread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Post?      @relation("PostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Post[]     @relation("PostReplies")
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  isDeleted Boolean    @default(false)
  likeCount Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  reports   Report[]
  likes     PostLike[]

  @@index([threadId, createdAt])
  @@index([parentId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  threads   Thread[]
}

model ThreadLike {
  userId    String
  threadId  String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread    Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, threadId])
  @@index([threadId])
}

model PostLike {
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
}

model ThreadBookmark {
  userId    String
  threadId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, threadId])
  @@index([threadId])
}

model ThreadRead {
  userId     String
  threadId   String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread     Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())

  @@id([userId, threadId])
  @@index([threadId])
}

model Report {
  id           String    @id @default(cuid())
  reporterId   String?
  reporter     User?     @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: SetNull)
  postId       String
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  reason       String
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolution   String?
  source      ReportSource @default(USER)

  @@index([resolvedAt])
  @@index([reporterId, postId])
}

// Fixed-window counters that survive a restart. One row per bucket.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

/// A write that the word filter refused. Kept so moderators can see attempts
/// that never became posts, and so a student who is repeatedly blocked can be
/// talked to before it escalates.
model BlockedAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// thread | reply | edit | board | profile
  surface   String
  /// title | body | tags | bio | board-name | board-description
  field     String
  /// Comma-joined matched terms, exactly as the filter saw them.
  words     String
  /// First 200 characters of the refused text, so the moderator has context.
  excerpt   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

/// Official notices and the changelog. They used to be a code constant; the
/// console needs to post a notice without a redeploy, so they live here now.
/// Only administrators may write them.
model Announcement {
  id          String   @id @default(cuid())
  /// Date shown to readers and used for ordering and for the unread count.
  publishedAt DateTime
  /// "notice" or "release"; the panel renders a different badge for each.
  kind        String   @default("notice")
  titleJa     String
  titleEn     String
  bodyJa      String
  bodyEn      String
  /// Drafts stay in the table but are not rendered anywhere public.
  isPublished Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
}
