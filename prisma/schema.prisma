// Data model for the Toyooka BBS.
//
// Conventions:
// - `cuid()` ids keep URLs opaque and sortable enough for a small community.
// - Content is soft-deleted (`isDeleted`) so moderation stays auditable.
// - Every account is local to this app; no external identity provider yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MODERATOR
  ADMIN
}

enum ReportSource {
  USER
  AUTO
}

model User {
  id              String           @id @default(cuid())
  username        String           @unique
  email           String?          @unique
  passwordHash    String
  role            Role             @default(STUDENT)
  createdAt       DateTime         @default(now())
  sessions        Session[]
  threads         Thread[]
  posts           Post[]
  reports         Report[]         @relation("ReportAuthor")
  resolvedReports Report[]         @relation("ReportResolver")
  postLikes       PostLike[]
  threadBookmarks ThreadBookmark[]
  auditLogs       AuditLog[]       @relation("AuditActor")
}

model Session {
  // SHA-256 of the cookie token, never the token itself.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Board {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  sortOrder   Int      @default(0)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  threads     Thread[]
}

model Thread {
  id            String           @id @default(cuid())
  boardId       String
  board         Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  authorId      String
  author        User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title         String
  isPinned      Boolean          @default(false)
  isLocked      Boolean          @default(false)
  isDeleted     Boolean          @default(false)
  likeCount     Int              @default(0)
  bookmarkCount Int              @default(0)
  createdAt     DateTime         @default(now())
  lastPostAt    DateTime         @default(now())
  posts         Post[]
  tags          Tag[]
  bookmarks     ThreadBookmark[]

  @@index([boardId, lastPostAt])
  @@index([likeCount])
}

model Post {
  id        String     @id @default(cuid())
  threadId  String
  thread    Thread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  isDeleted Boolean    @default(false)
  likeCount Int        @default(0)
  createdAt DateTime   @default(now())
  reports   Report[]
  likes     PostLike[]

  @@index([threadId, createdAt])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  threads   Thread[]
}

model PostLike {
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
}

model ThreadBookmark {
  userId    String
  threadId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, threadId])
  @@index([threadId])
}

model Report {
  id           String    @id @default(cuid())
  reporterId   String?
  reporter     User?     @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: SetNull)
  postId       String
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  reason       String
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolution   String?
  source      ReportSource @default(USER)

  @@index([resolvedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}
